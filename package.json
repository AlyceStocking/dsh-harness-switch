{
  "name": "@local/dsh-harness-switch",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Kimi API and per-model harness selection in native DSH sessions",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "vendor"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "openai": "^6.34.0",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.6.1",
    "zod": "4.3.6",
    "@anthropic-ai/sdk": "^0.95.2",
    "@google/genai": "^1.49.0",
    "picomatch": "^4.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pathe": "^2.0.3",
    "undici": "^7.27.1",
    "socks": "^2.8.9",
    "js-yaml": "^4.1.1",
    "immer": "^11.1.0",
    "chokidar": "^4.0.3",
    "xstate": "^5.32.5",
    "ignore": "^5.3.2",
    "@jsquash/webp": "^1.5.0",
    "jimp": "^1.6.1",
    "node-pty": "^1.1.0",
    "tar": "^7.5.13",
    "yauzl": "^3.3.0",
    "radashi": "^12.9.1",
    "semver": "^7.7.4",
    "retry": "0.13.1",
    "ulid": "^3.0.1",
    "yazl": "^3.3.1",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.12",
    "@antfu/utils": "^9.3.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
