{
  "name": "@local/dsh-harness-switch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Select a model harness and run Kimi Code from DeepSeek Harness.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "smol-toml": "1.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
